# =============================================================================
# Job Ops - Environment Variables
# Copy this file to .env and fill in your values
# =============================================================================

# Session secret for signed-cookie auth (HMAC-SHA256). REQUIRED in
# production — the server refuses to start without it. Set a long random
# string. Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

MODEL=google/gemini-3-flash-preview

# =============================================================================
# LLM Configuration
# =============================================================================
# API key for the LLM provider (comma-separated for key rotation).
# Get one at https://openrouter.ai/keys
LLM_API_KEY=
# Optional: override the provider (openrouter|openai|gemini|lmstudio|ollama|openai_compatible)
# LLM_PROVIDER=openrouter
# Optional: override the base URL (for self-hosted or compatible providers)
# LLM_BASE_URL=

# DEPRECATED (auto-copied to LLM_API_KEY for compatibility)
# OPENROUTER_API_KEY=your_openrouter_api_key_here

# Self-hosted RxResume base URL, e.g., http://rxresume.local.net
# Defaults to https://v4.rxresu.me
# RXRESUME_URL=

# RXResume credentials for PDF generation
# Create an account at: https://v4.rxresu.me
RXRESUME_EMAIL=your_email@example.com
RXRESUME_PASSWORD=your_password_here

# Optional: Basic Auth for write access
# the app is fully unauthenticated if this isn't set, which is the default
# When set, all write actions (POST/PATCH/DELETE) require Basic Auth.
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=
# In production, the server refuses to start without authentication.
# Set ALLOW_NO_AUTH=true to acknowledge the risk and allow running without auth
# (e.g., single-user self-hosted, behind a VPN, or in a trusted network).
# ALLOW_NO_AUTH=true

# CORS_ORIGIN is optional. In production, CORS is same-origin by default
# (no cross-origin requests allowed). Set this to allow specific origins:
#   CORS_ORIGIN=https://jobops.example.com
#   CORS_ORIGIN=https://app1.example.com,https://app2.example.com
# In development, CORS allows all origins when unset.
# CORS_ORIGIN=

# Public base URL used to generate tracer links when PDFs are created by
# background/pipeline runs (where request host cannot be inferred).
# Example: JOBOPS_PUBLIC_BASE_URL=https://jobops.example.com
JOBOPS_PUBLIC_BASE_URL=

# Optional path to the Tectonic LaTeX binary used by the built-in PDF
# exporter (defaults to "tectonic" on PATH). Docker images bundle Tectonic.
# TECTONIC_BIN=/usr/local/bin/tectonic

# =============================================================================
# Logging
# =============================================================================
# Console-only structured JSON logging (no log files, no rotation).
# Defaults to "info" for production-appropriate output. Set to debug for full
# verbose console output. "verbose" and "trace" are aliases for "debug".
# LOG_LEVEL=info

# =============================================================================
# Gmail OAuth (Tracking Inbox) - optional
# =============================================================================
# Required to connect Gmail from the UI.
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=

# Optional override for OAuth callback URL.
# If unset, defaults to <request-origin>/oauth/gmail/callback
# GMAIL_OAUTH_REDIRECT_URI=http://localhost:3005/oauth/gmail/callback

# =============================================================================
# UKVisaJobs (UK visa sponsorship jobs) - optional
# =============================================================================
# Provide email/password for automatic login and token refresh.
# See extractors/ukvisajobs/README.md for detailed instructions.
UKVISAJOBS_EMAIL=
UKVISAJOBS_PASSWORD=
UKVISAJOBS_HEADLESS=true

# =============================================================================
# USAJOBS (US federal jobs) - optional
# =============================================================================
# Free API key from https://developer.usajobs.gov/ . Required for the
# USAJOBS (Federal) source; without it the source is disabled.
USAJOBS_API_KEY=

# =============================================================================
# Adzuna (multi-country API source) - optional
# =============================================================================
# App credentials from Adzuna developer account.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Optional default per-term cap (can be overridden by UI run budget logic).
# ADZUNA_MAX_JOBS_PER_TERM=50


# =============================================================================
# Scheduled search notifications (Telegram) - optional
# =============================================================================
# Send scheduled-search results to Telegram. Both must be set to enable.
# Create a bot via @BotFather and get your chat id (e.g. via @userinfobot).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Webhook URL for scheduled-search results (defaults to PIPELINE_WEBHOOK_URL
# when unset). Receive { event: "search.scheduled_complete", topJobs, ... }.
# SEARCH_WEBHOOK_URL=

# =============================================================================
# JobSpy - Job search configuration
# =============================================================================
# Filter for remote-only jobs (default: 0 = disabled)
# JOBSPY_IS_REMOTE=0
# Max simultaneous job searches (default: 4)
# JOBSPY_MAX_ACTIVE_SEARCHES=4

# =============================================================================
# Crawl4AI (headless browser crawling) - optional
# =============================================================================
# Self-hosted Crawl4AI server for JS rendering and stealth crawling.
# When set, the jobboards crawl engine escalates direct → crawl4ai → jina.
# Run the sidecar via `docker compose up crawl4ai` (see docker-compose.yml).
CRAWL4AI_BASE_URL=
CRAWL4AI_API_TOKEN=
# Use Crawl4AI's undetected-browser mode (v0.7.3+) to bypass Cloudflare/Akamai.
# Requires crawl4ai:latest Docker image (v0.7.3+). Set to "true" to enable.
# CRAWL4AI_UNDETECTED=true

# =============================================================================
# Browser Use (interactive browser automation) — optional
# =============================================================================
# Self-hosted Browser Use server for agentic interactive workflows.
# When set, the crawl engine gains a `browser-use` backend that can
# navigate pages, solve challenges, and extract content like a human,
# and the agentic search orchestrator gains a `run_browser_task` tool.
# Run the sidecar via: docker compose --profile browser-use up -d
BROWSER_USE_BASE_URL=
# Shared secret required by the sidecar (must match BROWSER_USE_API_TOKEN
# on the browser-use container). Leave blank to disable browser-use.
BROWSER_USE_API_TOKEN=

# =============================================================================
# CAPTCHA Solving — optional
# =============================================================================
# When set, the crawl engine attempts to solve CAPTCHAs on challenge pages
# before escalating to the next backend. Supports 2Captcha and CapSolver.
# Without this, captchas are detected but only escalated past (not solved).
CAPTCHA_SOLVER_SERVICE=2captcha
CAPTCHA_SOLVER_API_KEY=
# Max wait for a solution (ms, default 120000)
# CAPTCHA_SOLVER_TIMEOUT_MS=120000
# Poll interval (ms, default 5000)
# CAPTCHA_SOLVER_POLLING_MS=5000
# Captcha solve budget caps to prevent unbounded 2Captcha/CapSolver spend
# against adversarial sites that serve a captcha on every page.
# CAPTCHA_BUDGET_PER_SOURCE=3
# CAPTCHA_BUDGET_GLOBAL=20

# =============================================================================
# ATS Direct API (Greenhouse, Lever, Ashby) — optional
# =============================================================================
# Scrape job postings directly from public ATS APIs (no auth, no browser).
# Comma-separated company/board identifiers.
# GREENHOUSE_BOARDS=anthropic,stripe,datadog
# LEVER_COMPANIES=mistralai,figma
# ASHBY_ORGS=deepl,notion

# =============================================================================
# Remote backups (S3-compatible: Cloudflare R2, AWS S3, MinIO, Backblaze B2)
# =============================================================================
# OPTIONAL but strongly recommended on ephemeral filesystems (Heroku):
# the SQLite database is mirrored to the object store and restored on boot
# when jobs.db is missing. Without this, data is lost when the filesystem
# is recreated.
#
# Cloudflare R2 (free tier): create a bucket, then an API token scoped to
# that bucket with Object Read & Write. Endpoint:
#   https://<ACCOUNT_ID>.r2.cloudflarestorage.com
#
# S3_ENDPOINT=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_BUCKET=
# Region for S3-compatible stores; Cloudflare R2 uses "auto".
# S3_REGION=auto
# Key prefix inside the bucket (default: jobops)
# S3_PREFIX=jobops
# Days to keep remote backups (0 disables pruning, default: 14)
# S3_RETENTION_DAYS=14

# =============================================================================
# Email Delivery (job search results) - optional
# =============================================================================
# SMTP server for sending job search result emails. If unset, email delivery
# is skipped (the search still completes and results are available in the UI).
# Any standard SMTP server works: Gmail, Mailtrap, AWS SES, Brevo, etc.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=jobops@localhost
# Default recipient when no authenticated user email is available (e.g. single-user mode)
# SMTP_DEFAULT_RECIPIENT=your_email@example.com

# =============================================================================
# Auth mode (multi-user / hosted deployments)
# =============================================================================
# AUTH_MODE=session enables per-user accounts as the only access path:
# unauthenticated /api requests are rejected with 401 instead of silently
# executing as the shared "default-user" tenant. Combine with
# SESSION_SECRET. Leave unset for single-user self-hosted defaults.
# AUTH_MODE=session

# =============================================================================
# Runtime resource knobs
# =============================================================================
# Directory for the SQLite database and generated files (default: ./data).
# DATA_DIR=./data
# Hard timeout per extractor run in ms (default: 600000 = 10 minutes).
# Applies to pipeline crawls and job searches alike.
# EXTRACTOR_RUN_TIMEOUT_MS=600000
# Process-wide ceiling on concurrently running pipelines across ALL users
# (default: 12). Per-user limit stays 3.
# PIPELINE_MAX_GLOBAL_RUNS=12
